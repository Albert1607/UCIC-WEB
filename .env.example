# ==========================================
# UCIC Website - Environment Variables Example
# ==========================================

# 1. PostgreSQL Database Connection (Local or Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/ucic_db

# 2. Admin Panel Fixed Credentials
ADMIN_EMAIL=admin@ucic.id
ADMIN_PASSWORD=change_this_to_a_secure_password

# 3. Session Secret (Random string for JWT signing, min 32 chars)
SESSION_SECRET=your_random_secret_key_at_least_32_characters_long

# 4. Site URL (Used for redirects and base paths)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 5. Supabase Storage (Used for media/file uploads)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
